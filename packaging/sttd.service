[Unit]
Description=sttd real-time speech-to-text
Documentation=file:///usr/share/doc/sttd/CONTEXT.md
# Mic + clipboard + paste live in the user's Wayland session: PipeWire for
# capture, WAYLAND_DISPLAY for wl-copy/ydotool, so this is a user unit, not
# a system one.
After=pipewire.socket wireplumber.service

[Service]
Type=simple
# Foreground on purpose: no --start. Under systemd the unit IS the
# supervisor -- --start would fork, have the parent exit 0 and leave the unit
# dead (and the cgroup cleaned up). systemd tracks this process directly, so
# `systemctl --user stop` sends SIGTERM to the normal graceful-flush path and
# the journal gets env_logger's stderr instead of /tmp/sttd.log.
ExecStart=/usr/bin/sttd --autopause --copy 1 --paste 1
# No STTD_START_PAUSED: the compiled default (paused) applies, so the unit
# comes up idle and transcribes nothing until armed.
#   systemctl --user kill -s SIGUSR2 sttd   # arm one sentence (--autopause is single-shot)
#   systemctl --user kill -s SIGHUP  sttd   # toggle pause/run
#   systemctl --user kill -s SIGUSR1 sttd   # pause
# Same control surface on the session bus (org.sttd.Daemon, unless --no-dbus),
# as two interfaces: org.sttd.Daemon at /org/sttd/Daemon for pause, and
# org.sttd.Dictionary at /org/sttd/Dictionary for the live word list.
# Import DBUS_SESSION_BUS_ADDRESS into the user manager first, or run these from
# a session shell:
#   busctl --user call org.sttd.Daemon /org/sttd/Daemon org.sttd.Daemon Pause
#   busctl --user call org.sttd.Daemon /org/sttd/Daemon org.sttd.Daemon Resume
#   busctl --user call org.sttd.Daemon /org/sttd/Daemon org.sttd.Daemon Toggle
#   busctl --user get-property org.sttd.Daemon /org/sttd/Daemon org.sttd.Daemon Paused
#   busctl --user call org.sttd.Daemon /org/sttd/Dictionary org.sttd.Dictionary LoadFile s /path/to/words.txt
#   busctl --user call org.sttd.Daemon /org/sttd/Dictionary org.sttd.Dictionary ReplaceWords as 2 AppImage Syntocinon
#   busctl --user get-property org.sttd.Daemon /org/sttd/Dictionary org.sttd.Dictionary Count
#   busctl --user monitor org.sttd.Daemon
# A missing session bus is not fatal: the service retries in the background and
# the signals above keep working.
# --copy/--paste need wl-clipboard/ydotoold and WAYLAND_DISPLAY in the user
# manager (`systemctl --user import-environment WAYLAND_DISPLAY`); without
# them emit.rs disables both with a warning.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
